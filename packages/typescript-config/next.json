{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "NextJS",
	"extends": "@chunithmsg/typescript-config/base.json",
	"compilerOptions": {
		"allowJs": true,
		"declaration": false,
		"declarationMap": false,
		"incremental": true,
		"jsx": "preserve",
		"lib": ["dom", "dom.iterable", "esnext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"target": "es6"
	}
}
