{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@chunithmsg/typescript-config/next.json",
  "include": [
    "../../packages/typescript-config/next-env.d.ts",
    "../../packages/typescript-config/*.d.ts",
    "../../packages/typescript-config/**/*.d.ts",
    "../../packages/typescript-config/**/*.ts",
    "../../packages/typescript-config/**/*.tsx",
    "../../packages/typescript-config/**/*.mdx",
