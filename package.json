{
	"name": "chunithmsg",
	"version": "1.0.0",
	"private": true,
	"sideEffects": false,
	"author": {
		"name": "Herbert Ilhan Tanujaya",
		"email": "mail@herbert.id",
		"url": "https://herbert.id"
	},
	"contributors": [
		{
			"name": "Muhammad Irham Rasyidi Bin Zainal"
		},
		{
			"name": "Ong Hin Journ",
			"email": "onghinjourn@gmail.com",
			"url": "https://notlega.github.io"
		},
		{
			"name": "Yang Yi Tan"
		}
	],
	"scripts": {
		"build:workspace": "turbo -F @chunithmsg/workspace-dependencies build",
		"changeset:new": "run-changeset-new",
		"check": "runx check",
		"check:ci": "run-s check:deps check:format check:turbo",
		"check:deps": "syncpack lint",
		"check:format": "prettier . --check --cache",
		"check:lint:all": "run-eslint",
		"check:turbo": "turbo check",
		"fix": "runx fix",
		"fix:deps": "run-fix-deps",
		"fix:format": "prettier . --write --cache",
		"fix:lint": "FIX_ESLINT=1 run-eslint",
		"fix:workers-types": "turbo fix:workers-types",
		"new-worker": "run-turbo-gen",
		"test": "vitest",
		"test:ci": "run-vitest-ci",
		"update-deps": "run-update-deps"
	},
	"packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
	"devDependencies": {
		"@changesets/cli": "2.29.4",
		"@ianvs/prettier-plugin-sort-imports": "4.4.2",
		"@chunithmsg/eslint-config": "workspace:*",
		"@chunithmsg/tools": "workspace:*",
		"@chunithmsg/typescript-config": "workspace:*",
		"@chunithmsg/workspace-dependencies": "workspace:*",
		"@turbo/gen": "2.5.3",
		"npm-run-all2": "8.0.4",
		"prettier": "3.5.3",
		"prettier-plugin-packagejson": "2.5.14",
		"syncpack": "13.0.4",
		"turbo": "2.5.3",
		"typescript": "5.5.4",
		"vitest": "3.1.4"
	},
	"pnpm": {
		"patchedDependencies": {
			"eslint-config-airbnb-extended@1.0.11": "patches/eslint-config-airbnb-extended@1.0.11.patch"
		}
	}
}
